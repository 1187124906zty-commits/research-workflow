{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/simulation-project-orchestrator/dissent-record.schema.json",
  "title": "Simulation Agent Dissent Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dissent_id", "task_id", "agent_id", "candidate_digest", "original_opinion_id",
    "original_opinion", "affected_claims", "failed_obligations", "severity",
    "revised_opinions", "resolution_evidence", "scope_before", "scope_after", "status"
  ],
  "properties": {
    "dissent_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "candidate_digest": { "type": "string", "minLength": 1 },
    "original_opinion_id": { "type": "string", "minLength": 1 },
    "original_opinion": { "type": "string", "minLength": 1 },
    "affected_claims": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "failed_obligations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "severity": { "type": "string", "minLength": 1 },
    "discriminating_test": { "type": ["string", "null"] },
    "revised_opinions": { "type": "array", "items": { "type": "string" } },
    "resolution_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
    "resolution_review_opinion_id": { "type": ["string", "null"] },
    "corrected_candidate_digest": { "type": ["string", "null"] },
    "scope_before": { "type": "array", "items": { "type": "string" } },
    "scope_after": { "type": "array", "items": { "type": "string" } },
    "retired_claim_ids": { "type": "array", "items": { "type": "string" } },
    "closed_by": { "type": ["string", "null"] },
    "closure_rationale": { "type": ["string", "null"] },
    "status": {
      "enum": [
        "OPEN", "TEST_PENDING", "RESOLVED_BY_EVIDENCE", "RESOLVED_BY_CORRECTION",
        "SCOPED_LIMITATION", "UNRESOLVED_BLOCKING"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "SCOPED_LIMITATION" } },
        "required": ["status"]
      },
      "then": {
        "required": ["retired_claim_ids"],
        "properties": {
          "retired_claim_ids": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator", "supports_claim"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "supports_claim": { "type": "string", "minLength": 1 }
      }
    }
  }
}
