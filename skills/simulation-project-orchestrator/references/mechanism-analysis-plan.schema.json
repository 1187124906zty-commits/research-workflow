{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/simulation-project-orchestrator/mechanism-analysis-plan.schema.json",
  "title": "Mechanism and Result Analysis Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "candidate_revision",
    "specification_revision",
    "physics_contract_revision",
    "source_set_revision",
    "physical_question",
    "claim_ceiling",
    "literature_analogies",
    "hypotheses",
    "required_outputs",
    "diagnostic_calculations",
    "comparison_design",
    "review_opinion_ids",
    "unresolved_limitations"
  ],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "string", "minLength": 1},
    "specification_revision": {"type": ["string", "integer"]},
    "physics_contract_revision": {"type": ["string", "integer"]},
    "source_set_revision": {"type": ["string", "integer"]},
    "physical_question": {"type": "string", "minLength": 1},
    "claim_ceiling": {"type": "string", "minLength": 1},
    "literature_analogies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator", "analytical_idea", "applicability_limit"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "analytical_idea": {"type": "string", "minLength": 1},
          "applicability_limit": {"type": "string", "minLength": 1}
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hypothesis_id", "mechanism", "competing_explanations", "predictions", "falsifiers", "required_output_ids"],
        "properties": {
          "hypothesis_id": {"type": "string", "minLength": 1},
          "mechanism": {"type": "string", "minLength": 1},
          "competing_explanations": {"type": "array", "items": {"type": "string"}},
          "predictions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "falsifiers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "required_output_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output_id", "variable", "unit", "location_or_region", "sampling", "kind", "export_or_derivation", "missing_consequence"],
        "properties": {
          "output_id": {"type": "string", "minLength": 1},
          "variable": {"type": "string", "minLength": 1},
          "unit": {"type": ["string", "null"]},
          "location_or_region": {"type": "string", "minLength": 1},
          "sampling": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "enum": ["RAW_FIELD", "RAW_HISTORY", "RAW_INTEGRAL", "DERIVED"]},
          "export_or_derivation": {"type": "string", "minLength": 1},
          "missing_consequence": {"type": "string", "minLength": 1}
        }
      }
    },
    "diagnostic_calculations": {"type": "array", "items": {"type": "string"}},
    "comparison_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["varied_conditions", "frozen_conditions", "aligned_observations", "measurement_operators"],
      "properties": {
        "varied_conditions": {"type": "array", "items": {"type": "string"}},
        "frozen_conditions": {"type": "array", "items": {"type": "string"}},
        "aligned_observations": {"type": "array", "items": {"type": "string"}},
        "measurement_operators": {"type": "array", "items": {"type": "string"}}
      }
    },
    "review_opinion_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "unresolved_limitations": {"type": "array", "items": {"type": "string"}}
  }
}
