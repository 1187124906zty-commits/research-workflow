{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/simulation-project-orchestrator/scientific-dialogue-message.schema.json",
  "title": "Cross-role Scientific Dialogue Message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id", "thread_id", "message_type", "timestamp", "sender_role",
    "receiver_roles", "project_id", "candidate_revision", "trigger",
    "self_audit", "question_or_answer", "evidence", "affected_claims",
    "affected_gates", "data_role_impact", "status"
  ],
  "properties": {
    "message_id": {"type": "string", "minLength": 1},
    "thread_id": {"type": "string", "minLength": 1},
    "predecessor_message_id": {"type": ["string", "null"]},
    "message_type": {"type": "string", "enum": ["QUESTION", "RESPONSE", "COUNTER_QUESTION", "RUN_REQUEST", "RUN_RESPONSE", "CLOSURE"]},
    "timestamp": {"type": "string", "format": "date-time"},
    "sender_role": {"type": "string", "minLength": 1},
    "receiver_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "project_id": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "string", "minLength": 1},
    "run_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "trigger": {"type": "string", "minLength": 1},
    "self_audit": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "question_or_answer": {"type": "string", "minLength": 1},
    "competing_explanations": {"type": "array", "items": {"type": "string"}},
    "requested_evidence_or_action": {"type": ["string", "null"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "affected_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "affected_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "data_role_impact": {"type": "string", "minLength": 1},
    "stop_line": {"type": "boolean", "default": false},
    "response_condition": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["OPEN", "PARTIAL", "ANSWERED", "UNRESOLVED", "CLOSED"]},
    "closure_kind": {
      "type": ["string", "null"],
      "enum": [null, "ANSWERED_BY_SOURCE", "ANSWERED_BY_REANALYSIS", "ANSWERED_BY_DISCRIMINATING_RUN", "CORRECTED_CANDIDATE", "SCOPED_LIMITATION", "UNRESOLVED_RETAINED", "NO_ADDITIONAL_RUN_JUSTIFIED"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "message_type": {"enum": ["QUESTION", "COUNTER_QUESTION", "RUN_REQUEST"]}
        },
        "required": ["message_type"]
      },
      "then": {
        "properties": {
          "competing_explanations": {"minItems": 2},
          "requested_evidence_or_action": {"type": "string", "minLength": 1},
          "response_condition": {"type": "string", "minLength": 1},
          "status": {"enum": ["OPEN", "PARTIAL"]}
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {"enum": ["RESPONSE", "RUN_RESPONSE"]}
        },
        "required": ["message_type"]
      },
      "then": {
        "properties": {
          "predecessor_message_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["PARTIAL", "ANSWERED", "UNRESOLVED"]}
        }
      }
    },
    {
      "if": {
        "properties": {"message_type": {"const": "COUNTER_QUESTION"}},
        "required": ["message_type"]
      },
      "then": {
        "properties": {
          "predecessor_message_id": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"message_type": {"const": "CLOSURE"}},
        "required": ["message_type"]
      },
      "then": {
        "properties": {
          "predecessor_message_id": {"type": "string", "minLength": 1},
          "status": {"const": "CLOSED"},
          "closure_kind": {
            "type": "string",
            "enum": ["ANSWERED_BY_SOURCE", "ANSWERED_BY_REANALYSIS", "ANSWERED_BY_DISCRIMINATING_RUN", "CORRECTED_CANDIDATE", "SCOPED_LIMITATION", "UNRESOLVED_RETAINED", "NO_ADDITIONAL_RUN_JUSTIFIED"]
          }
        }
      }
    }
  ]
}
