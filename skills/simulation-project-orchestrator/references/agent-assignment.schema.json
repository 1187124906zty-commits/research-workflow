{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/simulation-project-orchestrator/agent-assignment.schema.json",
  "title": "Simulation Agent Assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "project_id", "candidate_id", "candidate_digest", "spec_revision",
    "physics_contract_digest", "candidate_binding_level", "role_id", "role_charter_version", "mission",
    "decision_rights", "required_evidence", "blocking_conditions", "cannot_override",
    "inputs_expected_from_roles", "outputs_owed_to_roles", "questions_owned",
    "response_artifact", "response_due_event",
    "risk", "work_class", "capability_tier_required", "check_cadence", "review_key",
    "route_status", "model_requested", "model_actual", "fallback_reason",
    "model_adequacy_evidence", "model_adequacy_status", "routing_rationale", "scope", "inputs",
    "required_claims", "required_checks", "acceptance_criteria", "independence_group",
    "task_kind", "budget", "stop_conditions"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "parent_task_id": { "type": ["string", "null"] },
    "project_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "candidate_digest": { "type": "string", "minLength": 16 },
    "candidate_binding_level": { "enum": ["CONTENT_DIGEST", "DESCRIPTIVE_REVISION"] },
    "spec_revision": { "type": "integer", "minimum": 1 },
    "physics_contract_digest": { "type": "string", "minLength": 16 },
    "role_id": { "type": "string", "minLength": 1 },
    "role_charter_version": { "type": "string", "minLength": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "decision_rights": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "required_evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "blocking_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "cannot_override": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "inputs_expected_from_roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/roleEvidenceObligation" }
    },
    "outputs_owed_to_roles": {
      "type": "array",
      "items": { "$ref": "#/$defs/roleEvidenceObligation" }
    },
    "questions_owned": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "response_artifact": { "type": "string", "minLength": 1 },
    "response_due_event": { "type": "string", "minLength": 1 },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cou_consequence", "method_novelty", "coupling_complexity", "source_ambiguity", "numerical_sensitivity", "known_defect_severity"],
      "properties": {
        "cou_consequence": { "$ref": "#/$defs/riskLevel" },
        "method_novelty": { "$ref": "#/$defs/riskLevel" },
        "coupling_complexity": { "$ref": "#/$defs/riskLevel" },
        "source_ambiguity": { "$ref": "#/$defs/riskLevel" },
        "numerical_sensitivity": { "$ref": "#/$defs/riskLevel" },
        "known_defect_severity": { "$ref": "#/$defs/riskLevel" }
      }
    },
    "work_class": { "type": "string", "minLength": 1 },
    "capability_tier_required": { "enum": ["EXECUTION", "JUDGMENT", "FRONTIER"] },
    "check_cadence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "review_key": { "type": "string", "minLength": 1 },
    "route_status": { "enum": ["COMPLETED", "ROUTE_FAILED"] },
    "model_requested": { "type": "string", "minLength": 1 },
    "model_actual": { "type": ["string", "null"] },
    "fallback_reason": { "type": ["string", "null"] },
    "model_adequacy_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
    "model_adequacy_status": { "enum": ["PROVEN", "PROVISIONAL", "UNVERIFIED"] },
    "routing_rationale": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "inputs": { "type": "array", "items": { "type": "object", "additionalProperties": { "type": "string" } } },
    "required_claims": { "type": "array", "items": { "type": "string" } },
    "required_checks": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "reviewer_task_id": { "type": ["string", "null"] },
    "independence_group": { "type": "string", "minLength": 1 },
    "task_kind": { "type": "string", "minLength": 1 },
    "producer_task_id": { "type": ["string", "null"] },
    "budget": { "type": "object", "additionalProperties": { "type": ["integer", "number"] } },
    "stop_conditions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator", "supports_claim"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 },
        "supports_claim": { "type": "string", "minLength": 1 }
      }
    },
    "roleEvidenceObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "evidence_or_output", "claim_consequence_if_missing"],
      "properties": {
        "role_id": { "type": "string", "minLength": 1 },
        "evidence_or_output": { "type": "string", "minLength": 1 },
        "claim_consequence_if_missing": { "type": "string", "minLength": 1 }
      }
    }
  }
}
